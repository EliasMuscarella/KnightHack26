# Development defaults (no secrets here; this file is safe to commit).
# The synthetic FIXTURE company is hidden by default. To develop screens without real
# filings, run with the flag set explicitly: RISKDIFF_SHOW_FIXTURE=1 npm run dev
# (a yellow "FIXTURE DATA" banner is shown whenever it is listed). Never set it in production.
# RISKDIFF_SHOW_FIXTURE=1
# FastAPI backend for live analysis (the only public env var).
NEXT_PUBLIC_API_URL=http://localhost:8000
