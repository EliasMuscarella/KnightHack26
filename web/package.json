{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:types": "json2ts -i ../contract/.comparison.ts-input.schema.json -o src/types/comparison.ts --bannerComment \"/* eslint-disable */\n/** GENERATED from contract/comparison.schema.json by scripts/regen_contract.py. Do not edit. */\" --no-additionalProperties",
    "test:unit": "node --experimental-strip-types --test \"src/lib/__tests__/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "json-schema-to-typescript": "16.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
