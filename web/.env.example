# Copy to .env.local and adjust. No secrets belong in the frontend.

# Public: base URL of the RiskDiff FastAPI backend (live mode).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only: directory of published comparison JSON files
# (default: ../data/published relative to web/).
# RISKDIFF_PUBLISHED_DIR=/absolute/path/to/data/published

# Server-only: set to 1 to list the synthetic FIXTURE comparison (development only).
# RISKDIFF_SHOW_FIXTURE=1
