#Required enviromental variables
SEC_USER_AGENT="<name> <email>"
HF_TOKEN=
FINNHUB_API_KEY=
RISKDIFF_API_ORIGIN=
RISKDIFF_API_HOSTS=


# Used as a fall back if hugging face is unavailable. Optional.
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# RISKDIFF_EMBED_MODEL=BAAI/bge-m3
# RISKDIFF_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# RISKDIFF_DATA_DIR=data
# RISKDIFF_API_ORIGIN=http://localhost:3000

# Development only
# RISKDIFF_SHOW_FIXTURE=1      # frontend lists the synthetic FIXTURE company (never in production)
# RISKDIFF_ALLOW_FIXTURE=1     # API accepts POST /analyze for FIXTUR (output goes to data/scratch/)
# RISKDIFF_EMBED_BACKEND=lexical   # force the deterministic lexical fallback embedder (no model download)
# RISKDIFF_ALLOW_LEXICAL=1         # allow falling back to the lexical embedder when the HF model cannot load
# RISKDIFF_EMBED_REVISION=<sha>    # pin the embedding model revision (recorded in model_ids)
# RISKDIFF_ANALYZE_TIMEOUT=1500    # seconds per live analysis

# Data Bricks stuff
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=
DATABRICKS_VOLUME=
