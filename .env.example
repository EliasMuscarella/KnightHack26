# Copy to .env and fill in. Never commit .env.
# Required for SEC fetching. SEC fair-access policy requires a descriptive
# User-Agent with contact info, e.g. "RiskDiff Jane Doe jane@example.com".
SEC_USER_AGENT=

# Hugging Face token: used for Inference Providers (LLM rubric stage) and
# for downloading the embedding model from the Hub.
HF_TOKEN=

# Optional fallback LLM provider if Hugging Face Inference is unavailable.
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# RISKDIFF_EMBED_MODEL=BAAI/bge-m3
# RISKDIFF_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# RISKDIFF_DATA_DIR=data
# RISKDIFF_API_ORIGIN=http://localhost:3000

# Development only
# RISKDIFF_SHOW_FIXTURE=1      # frontend lists the synthetic FIXTURE company (never in production)
# RISKDIFF_ALLOW_FIXTURE=1     # API accepts POST /analyze for FIXTUR (output goes to data/scratch/)
# RISKDIFF_EMBED_BACKEND=lexical   # force the deterministic lexical fallback embedder (no model download)
# RISKDIFF_ANALYZE_TIMEOUT=1500    # seconds per live analysis
