# Copy to .env and fill in. Never commit .env.
# Required for SEC fetching. SEC fair-access policy requires a descriptive
# User-Agent with contact info, e.g. "RiskDiff Jane Doe jane@example.com".
SEC_USER_AGENT=

# Hugging Face token: used for Inference Providers (LLM rubric stage) and
# for downloading the embedding model from the Hub.
HF_TOKEN=

# Optional fallback LLM provider if Hugging Face Inference is unavailable.
GEMINI_API_KEY=

# Optional: Finnhub API key (free tier) for the home-page market ticker tape.
# Used only by the API process, never sent to the browser. Unset = the tape is hidden.
FINNHUB_API_KEY=

# Optional overrides (defaults shown)
# RISKDIFF_EMBED_MODEL=BAAI/bge-m3
# RISKDIFF_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# RISKDIFF_LLM_CONCURRENCY=6     # parallel LLM calls in stage 7 (1-16); output is identical at any value
# RISKDIFF_DATA_DIR=data
# RISKDIFF_API_ORIGIN=http://localhost:3000

# Development only
# RISKDIFF_SHOW_FIXTURE=1      # frontend ALSO lists the synthetic FIXTURE company with a warning banner (hidden by default; never in production)
# RISKDIFF_ALLOW_FIXTURE=1     # API accepts POST /analyze for FIXTUR (output goes to data/scratch/)
# RISKDIFF_EMBED_BACKEND=lexical   # force the deterministic lexical fallback embedder (no model download)
# RISKDIFF_ALLOW_LEXICAL=1         # allow falling back to the lexical embedder when the HF model cannot load
# RISKDIFF_EMBED_REVISION=<sha>    # pin the embedding model revision (recorded in model_ids)
# RISKDIFF_ANALYZE_TIMEOUT=1500    # seconds per live analysis

# Shared report library (Databricks), optional. With these unset everything is local-only.
# One-time setup: uv run python scripts/databricks_setup.py   (see README "Shared report library")
# DATABRICKS_HOST=https://<workspace>.cloud.databricks.com   # https URL on a Databricks domain, no path
# DATABRICKS_TOKEN=                                          # personal access token; server-side only, never in web/
# DATABRICKS_WAREHOUSE_ID=                                   # SQL warehouse id (Compute > SQL warehouses > Connection details)
# DATABRICKS_CATALOG=riskdiff                                # must already exist; the script creates the rest
# DATABRICKS_SCHEMA=main
# DATABRICKS_VOLUME=reports

# Briefing PDF (optional). The renderer opens the app's own /briefing/print page in the installed Chrome;
# RISKDIFF_WEB_ORIGIN=http://localhost:3000   # used only when the request's host is not loopback
